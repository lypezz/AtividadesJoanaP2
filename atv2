#include <stdio.h>

int main() {

    int numero;
    int total = 0;

    do {
        printf("Digite um numero (0 para sair): ");
        scanf("%d", &numero);
        total += numero;


        printf("Total do cofre: %d\n", total);

    } while (numero != 0);

    printf("O total adicionado foi R$: %d", total);

    return 0;
}
